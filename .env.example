# Application environment: development | test | staging | production
APP_ENV=development

# Leave empty for local dev (implicit dev secret + warning).
# Required for staging/production (min 32 chars):
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

EVM1_ADDRESS=

RPC_URL_MAINNET=
RPC_URL_BASE=
RPC_URL_BNB=
RPC_URL_ARB=
RPC_URL_LINEA=

# Optional
# JWT_ALG=HS256
# ACCESS_TOKEN_TTL_MIN=60
