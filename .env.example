# Application environment: development | test | staging | production
APP_ENV=development

# Non-sensitive release metadata exposed by health endpoints and OpenAPI.
APP_VERSION=0.2.0
BUILD_SHA=unknown

# Leave empty for local dev (implicit dev secret + warning).
# Required for staging/production (min 32 chars):
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

EVM1_ADDRESS=

# Each RPC variable accepts comma-separated primary and backup URLs.
RPC_URL_MAINNET=
RPC_URL_BASE=
RPC_URL_BNB=
RPC_URL_ARB=
RPC_URL_LINEA=

# Optional
# JWT_ALG=HS256
# ACCESS_TOKEN_TTL_MIN=60

# Snapshot service internal API
# For local host run: http://localhost:8001
# For docker compose network: http://py-wallet-snapshot-service:8001
SNAPSHOT_SERVICE_URL=http://localhost:8001
SNAPSHOT_INTERNAL_API_TOKEN=change-me
SNAPSHOT_SERVICE_TIMEOUT_SECONDS=5

# Auto-trigger snapshots
SNAPSHOT_AUTO_ON_WALLET_CREATE=true
SNAPSHOT_SCHEDULER_ENABLED=true
SNAPSHOT_SCHEDULER_INTERVAL_SECONDS=300

# Telegram Mini App. Keep TELEGRAM_BOT_TOKEN only in local/cluster secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=py_WalletBot
TELEGRAM_MINI_APP_URL=https://pywallet.dev/telegram
TELEGRAM_WEBHOOK_URL=https://pywallet.dev/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
# Global kill switch; each user must still explicitly opt in.
TELEGRAM_DAILY_BALANCE_ENABLED=false
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
