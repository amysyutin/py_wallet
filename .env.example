# Application environment: development | test | staging | production
APP_ENV=development

# Leave empty for local dev (implicit dev secret + warning).
# Required for staging/production (min 32 chars):
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

EVM1_ADDRESS=


# Optional
# JWT_ALG=HS256
# ACCESS_TOKEN_TTL_MIN=60

# Snapshot service internal API
# For local host run: http://localhost:8001
# For docker compose network: http://py-wallet-snapshot-service:8001
SNAPSHOT_SERVICE_URL=http://localhost:8001
SNAPSHOT_INTERNAL_API_TOKEN=change-me
SNAPSHOT_SERVICE_TIMEOUT_SECONDS=5

# Auto-trigger snapshots
SNAPSHOT_AUTO_ON_WALLET_CREATE=true
SNAPSHOT_SCHEDULER_ENABLED=true
SNAPSHOT_SCHEDULER_INTERVAL_SECONDS=300
